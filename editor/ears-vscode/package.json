{
  "name": "co-arising-ears",
  "displayName": "co-arising EARS",
  "description": "Syntax highlighting and Language Server (go-to-definition into structures/, live domain-boundary & Path-to-Layer diagnostics) for co-arising EARS (.ears) specs.",
  "version": "2.0.0",
  "publisher": "co-arising",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ears",
        "aliases": [
          "EARS",
          "co-arising EARS"
        ],
        "extensions": [
          ".ears"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ears",
        "scopeName": "source.ears",
        "path": "./syntaxes/ears.tmLanguage.json"
      }
    ]
  },
  "lspCommand": [
    "truthsrc",
    "lsp-ears"
  ]
}
