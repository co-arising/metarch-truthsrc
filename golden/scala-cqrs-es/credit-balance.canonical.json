{
  "schemaVersion": "truthsrc/v1",
  "workshop": "credit-balance",
  "knowledgeRelease": "1.0.0",
  "framework": { "base": "net.imadz.common" },
  "sessions": [],
  "aggregates": [
    {
      "name": "CreditBalance",
      "pkg": "net.imadz",
      "ctxPackage": "banking",
      "entity": "CreditBalanceEntity",
      "identifier": "userId",
      "aggregateReply": {
        "name": "CreditBalanceConfirmation",
        "fields": [
          {
            "name": "error",
            "type": "Option[iMadzError]"
          },
          {
            "name": "balances",
            "type": "List[Money]"
          }
        ]
      },
      "persistence": {
        "typeKey": "CreditBalance",
        "tagCount": 5
      },
      "commands": [
        {
          "name": "AddInitial",
          "parameters": [
            {
              "name": "initial",
              "dataType": "Money",
              "typeImport": "net.imadz.banking.domain.values.Money"
            }
          ],
          "reply": "aggregate"
        },
        {
          "name": "Deposit",
          "parameters": [
            {
              "name": "change",
              "dataType": "Money",
              "typeImport": "net.imadz.banking.domain.values.Money"
            }
          ],
          "reply": "aggregate"
        },
        {
          "name": "Withdraw",
          "parameters": [
            {
              "name": "change",
              "dataType": "Money",
              "typeImport": "net.imadz.banking.domain.values.Money"
            }
          ],
          "reply": "aggregate"
        },
        {
          "name": "GetBalance",
          "parameters": [],
          "reply": "aggregate",
          "readOnly": true
        },
        {
          "name": "ReserveFunds",
          "parameters": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            },
            {
              "name": "amount",
              "dataType": "Money",
              "typeImport": "net.imadz.banking.domain.values.Money"
            }
          ],
          "reply": {
            "name": "FundsReservationConfirmation",
            "fields": [
              {
                "name": "transferId",
                "type": "Id"
              },
              {
                "name": "error",
                "type": "Option[iMadzError]"
              }
            ]
          }
        },
        {
          "name": "DeductFunds",
          "parameters": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            }
          ],
          "reply": {
            "name": "FundsDeductionConfirmation",
            "fields": [
              {
                "name": "transferId",
                "type": "Id"
              },
              {
                "name": "error",
                "type": "Option[iMadzError]"
              }
            ]
          }
        },
        {
          "name": "ReleaseReservedFunds",
          "parameters": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            }
          ],
          "reply": {
            "name": "FundsReleaseConfirmation",
            "fields": [
              {
                "name": "transferId",
                "type": "Id"
              },
              {
                "name": "error",
                "type": "Option[iMadzError]"
              }
            ]
          }
        },
        {
          "name": "RecordIncomingCredits",
          "parameters": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            },
            {
              "name": "amount",
              "dataType": "Money",
              "typeImport": "net.imadz.banking.domain.values.Money"
            }
          ],
          "reply": {
            "name": "RecordIncomingCreditsConfirmation",
            "fields": [
              {
                "name": "transferId",
                "type": "Id"
              },
              {
                "name": "error",
                "type": "Option[iMadzError]"
              }
            ]
          }
        },
        {
          "name": "CommitIncomingCredits",
          "parameters": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            }
          ],
          "reply": {
            "name": "CommitIncomingCreditsConfirmation",
            "fields": [
              {
                "name": "transferId",
                "type": "Id"
              },
              {
                "name": "error",
                "type": "Option[iMadzError]"
              }
            ]
          }
        },
        {
          "name": "CancelIncomingCredit",
          "parameters": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            }
          ],
          "reply": {
            "name": "CancelIncomingCreditConfirmation",
            "fields": [
              {
                "name": "transferId",
                "type": "Id"
              },
              {
                "name": "error",
                "type": "Option[iMadzError]"
              }
            ]
          }
        }
      ],
      "behaviors": [
        {
          "name": "DirectBehaviors",
          "flows": [
            {
              "command": "AddInitial",
              "rule": "AddInitialOnlyOnceRule",
              "successReply": "CreditBalanceConfirmation"
            },
            {
              "command": "Deposit",
              "rule": "DepositRule",
              "successReply": "CreditBalanceConfirmation"
            },
            {
              "command": "Withdraw",
              "rule": "WithdrawRule",
              "successReply": "CreditBalanceConfirmation"
            }
          ]
        },
        {
          "name": "ReserveBehaviors",
          "flows": [
            {
              "command": "ReserveFunds",
              "rule": "ReserveFundsRule",
              "successReply": "FundsReservationConfirmation"
            },
            {
              "command": "DeductFunds",
              "rule": "DeductFundsRule",
              "successReply": "FundsDeductionConfirmation"
            },
            {
              "command": "ReleaseReservedFunds",
              "rule": "ReleaseReservedFundsRule",
              "successReply": "FundsReleaseConfirmation"
            }
          ]
        },
        {
          "name": "IncomingCreditBehaviors",
          "flows": [
            {
              "command": "RecordIncomingCredits",
              "rule": "RecordIncomingCreditsRule",
              "successReply": "RecordIncomingCreditsConfirmation"
            },
            {
              "command": "CommitIncomingCredits",
              "rule": "CommitIncomingCreditsRule",
              "successReply": "CommitIncomingCreditsConfirmation"
            },
            {
              "command": "CancelIncomingCredit",
              "rule": "CancelIncomingCreditRule",
              "successReply": "CancelIncomingCreditConfirmation"
            }
          ]
        }
      ],
      "factoryMethods": [
        {
          "name": "createCreditBalanceWithoutBalance",
          "params": [
            {
              "name": "userId",
              "dataType": "string (uuid)"
            }
          ]
        },
        {
          "name": "createCreditBalanceWithDefaultBalance",
          "params": [
            {
              "name": "userId",
              "dataType": "string (uuid)"
            },
            {
              "name": "initial",
              "dataType": "Money"
            }
          ]
        }
      ],
      "events": [
        {
          "name": "BalanceChanged",
          "payloads": [
            {
              "name": "update",
              "dataType": "Money"
            },
            {
              "name": "timestamp",
              "dataType": "Long"
            }
          ],
          "foldAssignments": [
            {
              "slot": "accountBalance",
              "expr": "updateAccountBalance(state, event.update.currency, event.update)"
            }
          ]
        },
        {
          "name": "FundsReserved",
          "payloads": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            },
            {
              "name": "amount",
              "dataType": "Money"
            }
          ],
          "foldAssignments": [
            {
              "slot": "accountBalance",
              "expr": "updateAccountBalance(state, event.amount.currency, event.amount.copy(amount = -event.amount.amount))"
            },
            {
              "slot": "reservedAmount",
              "expr": "state.reservedAmount + (event.transferId -> event.amount)"
            }
          ]
        },
        {
          "name": "FundsDeducted",
          "payloads": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            },
            {
              "name": "amount",
              "dataType": "Money"
            }
          ],
          "foldAssignments": [
            {
              "slot": "reservedAmount",
              "expr": "state.reservedAmount - event.transferId"
            }
          ]
        },
        {
          "name": "ReservationReleased",
          "payloads": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            },
            {
              "name": "amount",
              "dataType": "Money"
            }
          ],
          "foldAssignments": [
            {
              "slot": "accountBalance",
              "expr": "updateAccountBalance(state, event.amount.currency, event.amount)"
            },
            {
              "slot": "reservedAmount",
              "expr": "state.reservedAmount - event.transferId"
            }
          ]
        },
        {
          "name": "IncomingCreditsRecorded",
          "payloads": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            },
            {
              "name": "amount",
              "dataType": "Money"
            }
          ],
          "foldAssignments": [
            {
              "slot": "incomingCredits",
              "expr": "state.incomingCredits.updated(event.transferId, event.amount)"
            }
          ]
        },
        {
          "name": "IncomingCreditsCommited",
          "payloads": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            }
          ],
          "foldAssignments": [
            {
              "slot": "accountBalance",
              "expr": "updateAccountBalance(state, state.incomingCredits(event.transferId).currency, state.incomingCredits(event.transferId))"
            },
            {
              "slot": "incomingCredits",
              "expr": "state.incomingCredits - event.transferId"
            }
          ]
        },
        {
          "name": "IncomingCreditsCanceled",
          "payloads": [
            {
              "name": "transferId",
              "dataType": "string (uuid)"
            }
          ],
          "foldAssignments": [
            {
              "slot": "incomingCredits",
              "expr": "state.incomingCredits - event.transferId"
            }
          ]
        }
      ],
      "stateFields": [
        {
          "name": "userId",
          "dataType": "string (uuid)"
        },
        {
          "name": "accountBalance",
          "dataType": "Map[String, Money]",
          "typeImport": "net.imadz.banking.domain.values.Money",
          "defaultValue": "Map.empty"
        },
        {
          "name": "reservedAmount",
          "dataType": "Map[Id, Money]",
          "typeImport": "net.imadz.banking.domain.values.Money",
          "defaultValue": "Map.empty"
        },
        {
          "name": "incomingCredits",
          "dataType": "Map[Id, Money]",
          "typeImport": "net.imadz.banking.domain.values.Money",
          "defaultValue": "Map.empty"
        }
      ],
      "stateHelpers": [
        {
          "name": "updateAccountBalance",
          "description": "state.accountBalance + (currency.getCurrencyCode -> Money(currentBalance.amount + updateMoney.amount, currency))",
          "params": [
            {
              "name": "state",
              "type": "CreditBalanceState"
            },
            {
              "name": "currency",
              "type": "Currency",
              "typeImport": "java.util.Currency"
            },
            {
              "name": "updateMoney",
              "type": "Money",
              "typeImport": "net.imadz.banking.domain.values.Money"
            }
          ],
          "returnType": "Map[String, Money]"
        }
      ],
      "repository": {
        "entityRefFamily": "CreditBalanceAggregateCommandFamily",
        "entityRefFamilyImport": "net.imadz.banking.application.aggregates.CreditBalanceAggregateProtocol.CreditBalanceAggregateCommandFamily",
        "finders": [
          {
            "name": "findCreditBalanceByUserId",
            "param": {
              "name": "userId",
              "dataType": "string (uuid)"
            },
            "logic": "通过 Sharding 获取聚合根引用"
          }
        ]
      }
    }
  ],
  "valueObjects": [],
  "readModels": [],
  "stories": []
}
