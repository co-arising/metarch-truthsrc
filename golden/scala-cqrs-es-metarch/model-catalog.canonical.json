              {
                "name": "error",
                "type": "Option[iMadzError]"
              }
            ]
          },
          "preconditionRules": [
            {
              "expression": {
                "notIn": [
                  {
                    "var": "aggregate.status"
                  },
                  [
                    "CONFLICT_DETECTED"
                  ]
                ]
              },
              "humanDescription": "执行 DetectCatalogConflicts 前，聚合状态不能为 CONFLICT_DETECTED"
            },
            {
              "expression": {
                "notNull": {
                  "var": "DetectCatalogConflicts.triggeredBy"
