        {
          "name": "CreateCatalogVersion",
          "parameters": [
            {
              "name": "tenantId",
              "dataType": "string (uuid)",
              "noteId": "8fd6319e-3634-48f1-8358-8586470da636"
            },
            {
              "name": "projectId",
              "dataType": "string (uuid)",
              "noteId": "ec0497be-920f-478e-95ff-6f7aeaf54a7c"
            },
            {
              "name": "version",
              "dataType": "String",
              "noteId": "c7341120-b633-4a8f-a49b-65d64961c76e"
            },
            {
              "name": "baseVersion",
              "dataType": "String",
              "noteId": "6d713df0-ba9e-4169-94ed-3e2b5603fb28"
            },
            {
              "name": "triggeredBy",
              "dataType": "String"
            }
          ],
          "reply": {
            "name": "CreateCatalogVersionReply",
            "fields": [
              {
                "name": "error",
                "type": "Option[iMadzError]"
              }
            ]
          },
          "preconditionRules": [
            {
              "expression": {
                "pattern": {
                  "var": "CreateCatalogVersion.version",
                  "regex": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                }
              },
              "humanDescription": "`version` 必须匹配正则 `^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$`"
            },
            {
              "expression": {
                "notNull": {
                  "var": "CreateCatalogVersion.triggeredBy"
                }
              },
              "humanDescription": "CreateCatalogVersion.triggeredBy 不能为空"
            },
            {
              "expression": {
                "refExists": {
                  "var": "CreateCatalogVersion.projectId",
                  "target": "Project"
                }
              },
              "humanDescription": "CreateCatalogVersion.projectId 引用必须存在（→Project）"
            }
          ],
          "behaviorModel": {
            "emissions": [
              {
                "event": "CatalogVersionCreated",
                "bindings": {
                  "timestamp": "system:now",
                  "projectId": "param.projectId",
                  "version": "param.version",
                  "triggeredBy": "param.triggeredBy",
                  "catalogId": "state.catalogId",
                  "baseVersion": "param.baseVersion",
                  "tenantId": "param.tenantId"
                }
              }
            ]
          }
        },
        {
          "name": "DetectCatalogConflicts",
          "parameters": [
            {
              "name": "catalogId",
              "dataType": "string (uuid)",
              "noteId": "a343334d-61c9-4bb5-9fdb-7d49341c2790"
            },
            {
