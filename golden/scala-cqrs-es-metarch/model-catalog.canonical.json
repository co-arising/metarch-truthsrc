      "identifier": "catalogId",
      "identifierType": "string (uuid)",
      "noteId": "19ff11ca-c36d-430c-8219-7e7f685d20c3",
      "commandFamily": "ModelCatalogCommandFamily",
      "persistence": {
        "typeKey": "ModelCatalog",
        "tagCount": 1,
        "tagPrefix": "ModelCatalogTag"
      },
      "commands": [
        {
          "name": "ApplyKnowledgePatch",
          "parameters": [
            {
              "name": "catalogId",
              "dataType": "string (uuid)",
              "noteId": "d763afa2-8a50-4d0a-aaa3-2ab71a69a17d"
            },
            {
              "name": "sessionId",
              "dataType": "string (uuid)",
              "noteId": "aef1771d-c8f8-447b-8c8b-0aa060d60dd4"
            },
            {
              "name": "patchId",
              "dataType": "string (uuid)",
              "noteId": "5199b893-ff25-4395-a847-25cb85bdec11"
            },
            {
              "name": "patchHash",
              "dataType": "String",
              "noteId": "96d19100-3beb-4ffc-a76a-369e0c0d95fc"
            },
            {
              "name": "parentPatchId",
              "dataType": "string (uuid)",
              "noteId": "65c7df6b-db19-4b5d-8694-f4b11334830a"
            },
            {
              "name": "concepts",
              "dataType": "List[ConceptDelta]",
              "noteId": "ecb340af-2880-4968-af7f-bfa647db6f40",
              "typeImport": "net.imadz.metarch.domain.values.ConceptDelta"
            },
            {
              "name": "triggeredBy",
              "dataType": "String"
            }
          ],
          "reply": {
            "name": "ApplyKnowledgePatchReply",
            "fields": [
              {
                "name": "error",
                "type": "Option[iMadzError]"
              }
            ]
          },
          "preconditionRules": [
            {
              "expression": {
                "notNull": {
                  "var": "ApplyKnowledgePatch.concepts"
                }
              },
              "humanDescription": "ApplyKnowledgePatch.concepts 必须非空"
            },
            {
              "expression": {
                "notNull": {
                  "var": "ApplyKnowledgePatch.triggeredBy"
                }
              },
              "humanDescription": "ApplyKnowledgePatch.triggeredBy 不能为空"
            },
            {
              "expression": {
                "refExists": {
                  "var": "ApplyKnowledgePatch.sessionId",
                  "target": "Session"
                }
              },
              "humanDescription": "ApplyKnowledgePatch.sessionId 引用必须存在（→Session）"
            }
          ],
          "behaviorModel": {
            "emissions": [
              {
                "event": "KnowledgePatched",
                "bindings": {
                  "timestamp": "system:now",
                  "triggeredBy": "param.triggeredBy",
                  "catalogId": "param.catalogId",
                  "tenantId": "state.tenantId",
                  "patchSet": "expr:CatalogPatchSet(p.sessionId.toString, p.concepts, Instant.now())",
                  "patchId": "param.patchId",
                  "patchHash": "param.patchHash"
                }
              }
            ],
            "emitWhen": [
              {
                "cond": {
                  "or": [
                    {
                      "notEqual": [
                        {
                          "var": "ApplyKnowledgePatch.parentPatchId"
                        },
                        {
                          "var": "ModelCatalog.headPatchId"
                        }
                      ]
                    },
                    {
                      "expr": "adjudicator.hasConflicts(p.concepts, state.conceptIndex)"
                    }
                  ]
                },
                "events": [
                  {
                    "event": "CatalogConflictDetected",
                    "bindings": {
                      "timestamp": "system:now",
                      "patchId": "state.patchId",
                      "triggeredBy": "param.triggeredBy",
                      "catalogId": "param.catalogId",
                      "tenantId": "state.tenantId",
                      "conflictSet": "expr:CatalogConflictSet(Instant.now(), adjudicator.conflicts(p.concepts, state.conceptIndex))"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "name": "AssembleMetadata",
