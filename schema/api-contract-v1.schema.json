{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "truthsrc.api-contract/v1",
  "title": "Finite authored API contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "context", "aggregate", "resourceType", "commands", "query", "page", "readinessPath"],
  "properties": {
    "schemaVersion": { "const": "truthsrc.api-contract/v1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "const": "1" },
    "context": { "type": "string", "minLength": 1 },
    "aggregate": { "$ref": "#/$defs/ref" },
    "resourceType": { "$ref": "#/$defs/ref" },
    "commands": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/command" } },
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "persistence", "index", "query", "path", "resourceParameter", "roles", "pageSize", "maxPageSize", "output"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "persistence": { "$ref": "#/$defs/pin" },
        "index": { "$ref": "#/$defs/id" }, "query": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" },
        "resourceParameter": { "$ref": "#/$defs/id" }, "roles": { "const": ["reader", "operator"] },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxPageSize": { "type": "integer", "minimum": 1, "maximum": 64 },
        "output": { "type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {
          "key": { "$ref": "#/$defs/id" }, "value": { "$ref": "#/$defs/id" }
        } }
      }
    },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "title", "query"], "properties": {
        "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 }, "query": { "$ref": "#/$defs/id" }
      }
    },
    "readinessPath": { "$ref": "#/$defs/path" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "path": { "type": "string", "minLength": 2, "maxLength": 512 },
    "pin": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {
      "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }
    } },
    "ref": { "type": "object", "additionalProperties": false, "required": ["context", "kind", "owner", "id"], "properties": {
      "context": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 },
      "owner": { "type": "array", "items": { "type": "string" } }, "id": { "type": "string", "minLength": 1 }
    } },
    "input": { "type": "object", "additionalProperties": false, "required": ["field", "parameter", "codec", "maxLength", "location"], "properties": {
      "field": { "$ref": "#/$defs/id" }, "parameter": { "$ref": "#/$defs/ref" },
      "codec": { "enum": ["string", "long-string", "boolean"] }, "maxLength": { "type": ["integer", "null"], "minimum": 1, "maximum": 256 },
      "location": { "enum": ["path", "body"] }
    } },
    "output": { "type": "object", "additionalProperties": false, "required": ["field", "slot", "codec", "maxLength"], "properties": {
      "field": { "$ref": "#/$defs/id" }, "slot": { "$ref": "#/$defs/ref" },
      "codec": { "enum": ["string", "long-string", "boolean"] }, "maxLength": { "type": ["integer", "null"], "minimum": 1, "maximum": 256 }
    } },
    "command": { "type": "object", "additionalProperties": false,
      "required": ["id", "command", "method", "path", "roles", "csrf", "request", "result"], "properties": {
        "id": { "$ref": "#/$defs/id" }, "command": { "$ref": "#/$defs/ref" }, "method": { "const": "POST" },
        "path": { "$ref": "#/$defs/path" }, "roles": { "const": ["operator"] }, "csrf": { "const": true },
        "request": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/input" } },
        "result": { "type": "object", "additionalProperties": false, "required": ["event", "fields", "empty"], "properties": {
          "event": { "$ref": "#/$defs/ref" }, "empty": { "const": "no-change" },
          "fields": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/output" } }
        } }
      }
    }
  }
}
