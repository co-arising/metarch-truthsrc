            "left": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
            },
            "right": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
