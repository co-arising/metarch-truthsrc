            "amount": {
              "type": "string",
              "maxLength": 65536,
              "pattern": "^(param|state)\\.[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "form",
            "amount",
            "in"
          ],
          "properties": {
            "form": {
              "const": "money-sufficient"
            },
            "amount": {
              "type": "string",
              "maxLength": 65536,
              "pattern": "^(param|state)\\.[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            },
            "in": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "form",
            "map",
            "collection"
          ],
          "properties": {
            "form": {
              "const": "collection-covered"
            },
            "map": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            },
            "collection": {
              "type": "string",
              "maxLength": 65536,
              "pattern": "^(param|state)\\.[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            }
          }
        }
      ]
    },
