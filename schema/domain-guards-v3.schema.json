      "properties": {
        "event": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
        },
        "source": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/source"
        },
        "declaredSlots": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/declaredSlot"
          }
        }
      }
    },
    "stableIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "keys"
      ],
      "properties": {
        "id": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/text"
        },
        "version": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/text"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "command",
        "outputType",
        "inputDependencies",
        "stableIdentityContract",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
        },
        "version": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/text"
        },
        "command": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
        },
        "outputType": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/type"
        },
        "inputDependencies": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/refs"
        },
        "stableIdentityContract": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/stableIdentity"
        },
        "source": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/source"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "events",
        "hosts"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/command"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/event"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/host"
          }
        }
      }
    },
    "dependencyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "dependencies"
      ],
      "properties": {
        "schemaVersion": {
          "const": "truthsrc.domain-dependency-binding/v3"
        },
        "dependencies": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/dependencies"
        }
      }
    },
    "default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "valueType",
        "source",
        "value"
