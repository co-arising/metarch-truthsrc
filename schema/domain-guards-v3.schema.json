    "eventFolds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "source",
        "assignments"
      ],
      "properties": {
        "event": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
        },
        "source": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/source"
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/assignment"
          }
        }
      }
    },
    "folds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaults",
        "events"
      ],
      "properties": {
        "defaults": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/default"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/eventFolds"
          }
        }
      }
    },
    "foldBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "folds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "truthsrc.domain-fold-binding/v3"
        },
        "folds": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/folds"
        }
      }
    },
    "decisionExpression": {
      "oneOf": [
        {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/refExpression"
        },
        {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/booleanExpression"
        },
        {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/stringExpression"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "argument",
            "member"
          ],
          "properties": {
            "op": {
              "const": "member"
            },
            "argument": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/decisionExpression"
            },
            "member": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "argument"
          ],
          "properties": {
            "op": {
              "enum": [
                "not",
                "is-empty",
                "non-empty",
                "map-keys",
                "exact-positive"
              ]
            },
            "argument": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/decisionExpression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "enum": [
                "and",
                "or",
                "equal",
                "not-equal",
                "map-contains",
                "map-get",
                "map-lookup",
                "contains",
                "all-equal",
                "less",
                "less-equal",
                "greater",
                "greater-equal",
                "add",
                "subtract",
                "exact-sufficient",
                "collection-covered"
              ]
            },
            "left": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/decisionExpression"
            },
            "right": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/decisionExpression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "const": "integer"
            },
            "value": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceOrdinal",
        "ruleId",
        "source",
        "predicate",
        "onFalse",
        "dependencies"
      ],
      "properties": {
        "sourceOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "ruleId": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "source": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/source"
        },
        "predicate": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/decisionExpression"
        },
        "onFalse": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/onFalse"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands"
