            "PROPAGATED"
          ]
        },
        "source": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/source"
        }
      }
    },
    "declaredSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "valueType",
        "source"
      ],
      "properties": {
        "ref": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
        },
        "valueType": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/type"
        },
        "source": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/source"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "valueType",
        "source",
        "producer",
        "dependencies"
      ],
      "properties": {
        "slot": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
        },
        "valueType": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/type"
        },
        "source": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/source"
        },
        "producer": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
        },
        "dependencies": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/refs"
        }
      }
    },
    "emission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "source",
        "slots"
      ],
      "properties": {
        "event": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
        },
        "source": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/source"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/slot"
          }
        }
      }
