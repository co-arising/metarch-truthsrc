    "ref": {
      "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
    },
    "source": {
      "$ref": "urn:truthsrc:product-compilation:v1#/$defs/source"
    },
    "type": {
      "$ref": "urn:truthsrc:product-compilation:v1#/$defs/valueType"
    },
    "text": {
      "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
    },
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
      }
    },
    "json": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "maxLength": 65536
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/json"
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "ref"
          ],
          "properties": {
            "op": {
              "const": "ref"
            },
            "ref": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "valueType",
            "value"
          ],
          "properties": {
            "op": {
              "const": "literal"
            },
            "valueType": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/type"
            },
            "value": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "version"
          ],
          "properties": {
            "op": {
              "const": "host"
            },
            "id": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
            },
            "version": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "argument",
            "member"
          ],
          "properties": {
            "op": {
              "const": "member"
            },
            "argument": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
            },
            "member": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "map",
            "key"
          ],
          "properties": {
            "op": {
              "const": "map-get"
            },
            "map": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
            },
            "key": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "enum": [
                "add",
                "subtract"
              ]
