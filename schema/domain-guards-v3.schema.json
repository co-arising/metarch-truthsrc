    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "source",
        "declaredSignature",
        "usedDependencies",
        "events"
      ],
      "properties": {
        "command": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
        },
        "source": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/source"
        },
        "declaredSignature": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/parameter"
          }
        },
        "usedDependencies": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/refs"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:domain-guards:v3#/$defs/emission"
          }
        }
      }
