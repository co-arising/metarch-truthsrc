      "properties": {
        "target": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
        },
        "valueType": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/type"
        },
        "source": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/source"
        },
        "value": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/json"
        }
      }
    },
    "update": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "const": "set"
            },
            "value": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key",
            "value"
          ],
          "properties": {
            "op": {
              "enum": [
                "put",
                "put-all"
              ]
            },
            "key": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
            },
            "value": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key"
          ],
          "properties": {
            "op": {
              "enum": [
                "remove",
                "remove-all"
              ]
            },
            "key": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "delta",
            "sign"
          ],
          "properties": {
            "op": {
              "enum": [
                "integer-apply",
                "money-apply"
              ]
            },
            "delta": {
              "$ref": "urn:truthsrc:domain-guards:v3#/$defs/expression"
            },
            "sign": {
              "enum": [
                1,
                -1
              ]
            }
          }
        }
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "valueType",
        "sourceOrdinal",
        "source",
        "update",
        "dependencies"
      ],
      "properties": {
        "target": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/ref"
        },
        "valueType": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/type"
        },
        "sourceOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "source": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/source"
        },
        "update": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/update"
        },
        "dependencies": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/refs"
        }
