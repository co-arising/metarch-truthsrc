{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truthsrc:domain-guards:v3",
  "title": "Explicit v3 finite guards and compatible dataflow",
  "$comment": "Shape only; source correspondence, type identity, units, overflow and original order require the semantic compiler. v1/v2 remain unchanged.",
