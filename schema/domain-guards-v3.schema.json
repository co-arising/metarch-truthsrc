            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "source",
              "decisions"
            ],
            "properties": {
              "command": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
              },
              "source": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/source"
              },
              "decisions": {
                "type": "array",
                "items": {
                  "$ref": "urn:truthsrc:domain-guards:v3#/$defs/decision"
                }
              }
            }
          }
        }
      }
    },
    "semanticBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "decisions"
      ],
      "properties": {
        "schemaVersion": {
          "const": "truthsrc.domain-semantic-binding/v3"
        },
        "decisions": {
          "$ref": "urn:truthsrc:domain-guards:v3#/$defs/decisions"
        }
      }
    },
    "structuredWhen": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "form",
            "amount"
          ],
          "properties": {
            "form": {
              "const": "money-positive"
