{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truthsrc:persistence-readside-contract:v1",
  "title": "Reconstructed static persistence/readside obligations, not runtime or wire compatibility certification",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "context", "aggregate", "aggregateSource", "source", "wire", "store"],
  "properties": {
    "schemaVersion": { "const": "truthsrc.persistence-readside-contract/v1" },
    "id": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/token" },
    "version": { "const": "1" },
    "context": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "aggregate": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/aggregateRef" },
    "aggregateSource": { "$ref": "#/$defs/source" },
    "source": { "$ref": "#/$defs/source" },
    "wire": {
      "type": "object", "additionalProperties": false,
      "required": ["serializerId", "envelopeVersion", "registrations", "source"],
      "properties": {
        "serializerId": { "type": "integer", "minimum": 1001, "maximum": 2147483647 },
        "envelopeVersion": { "const": 1 },
        "source": { "$ref": "#/$defs/source" },
        "registrations": { "type": "array", "minItems": 2, "maxItems": 65, "items": { "$ref": "#/$defs/registration" } }
      }
    },
    "store": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "id", "version", "dialect", "tablePrefix", "source", "identity", "streamKind", "pollIntervalMillis", "closeTimeoutMillis", "pageSize", "maxPayloadBytes", "maxPending", "indexes", "bindingSource"],
      "properties": {
        "schemaVersion": { "const": "truthsrc.journal-readside/v2" },
        "id": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/scalaName" },
        "version": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/version" },
        "dialect": { "const": "h2-2" },
        "tablePrefix": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/sqlName" },
        "source": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/store/properties/source" },
        "identity": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/store/properties/identity" },
        "streamKind": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/store/properties/streamKind" },
        "pollIntervalMillis": { "type": "integer", "minimum": 10, "maximum": 60000 },
        "closeTimeoutMillis": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maxPayloadBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "maxPending": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "bindingSource": { "$ref": "#/$defs/source" },
        "indexes": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/index" } }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false, "required": ["document", "pointer"],
      "properties": {
        "document": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "pointer": { "type": "string", "maxLength": 65536, "pattern": "^(?:/(?:[^~]|~[01])*)*$(?![\\s\\S])" }
      }
    },
    "registration": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "role", "typeId", "version", "layoutSha256", "source", "domainSource"],
      "properties": {
        "ref": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/ref" },
        "role": { "enum": ["event", "state"] },
        "typeId": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/token" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "layoutSha256": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/sha256" },
        "source": { "$ref": "#/$defs/source" },
        "domainSource": { "$ref": "#/$defs/source" }
      },
      "allOf": [{
        "if": { "properties": { "role": { "const": "event" } } },
        "then": { "properties": { "ref": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/eventRef" } } },
        "else": { "properties": { "ref": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/aggregateRef" } } }
      }]
    },
    "typeRef": {
      "allOf": [{ "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/ref" }, { "properties": { "kind": { "const": "type" }, "owner": { "maxItems": 0 } } }]
    },
    "carrier": {
      "type": "object", "additionalProperties": false, "required": ["ref", "source"],
      "properties": { "ref": { "$ref": "#/$defs/typeRef" }, "source": { "$ref": "#/$defs/source" } }
    },
    "textType": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["form", "name"], "properties": { "form": { "const": "primitive" }, "name": { "const": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["form", "ref"], "properties": { "form": { "const": "nominal" }, "ref": { "$ref": "#/$defs/typeRef" } } }
      ]
    },
    "column": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "size", "nullable"],
      "properties": {
        "name": { "enum": ["pid_key", "persistence_id", "resource_id", "map_key", "map_value"] },
        "type": { "enum": ["digest", "text"] },
        "size": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 2048 }] },
        "nullable": { "const": false }
      }
    },
    "index": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "table", "stateField", "keySize", "valueSize", "query", "source", "fieldSource", "valueType", "keyCarriers", "valueCarriers", "sql"],
      "properties": {
        "id": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/scalaName" },
        "table": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/sqlName" },
        "stateField": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/stateFieldRef" },
        "keySize": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "valueSize": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "query": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/index/properties/query" },
        "source": { "$ref": "#/$defs/source" },
        "fieldSource": { "$ref": "#/$defs/source" },
        "valueType": {
          "type": "object", "additionalProperties": false, "required": ["form", "key", "value"],
          "properties": { "form": { "const": "map" }, "key": { "$ref": "#/$defs/textType" }, "value": { "$ref": "#/$defs/textType" } }
        },
        "keyCarriers": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/carrier" } },
        "valueCarriers": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/carrier" } },
        "sql": {
          "type": "object", "additionalProperties": false, "required": ["id", "table", "columns", "key", "queries"],
          "properties": {
            "id": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/scalaName" },
            "table": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/sqlName" },
            "columns": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/column" } },
            "key": { "const": ["pid_key", "map_key"] },
            "queries": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["id", "where", "orderBy"],
                "properties": { "id": { "$ref": "urn:truthsrc:persistence-readside-binding:v1#/$defs/sqlName" }, "where": { "const": ["resource_id"] }, "orderBy": { "const": ["map_key", "pid_key"] } }
              }
            }
          }
        }
      }
    }
  }
}
