{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truthsrc:artifact-contract:v2",
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "artifact",
        "status",
        "provenance",
        "references",
        "ports",
        "deployment",
        "implementations",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "version": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "artifact": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
        },
        "status": {
          "enum": [
            "selected",
            "proposal",
            "historical"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:product-compilation:v1#/$defs/source"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
          },
          "uniqueItems": true
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "version",
              "inputType",
              "outputType",
              "required"
            ],
            "properties": {
              "ref": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
              },
              "version": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
              },
              "inputType": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/valueType"
              },
              "outputType": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/valueType"
              },
              "required": {
                "const": true
              }
            }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "secretRefs"
          ],
          "properties": {
            "id": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            },
            "version": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            },
            "secretRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "provider"
                ],
                "properties": {
                  "id": {
                    "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
                  },
                  "provider": {
                    "enum": [
                      "environment",
                      "keystore"
                    ]
                  }
                }
              }
            }
          }
        },
        "implementations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port",
              "id",
              "version"
            ],
            "properties": {
              "port": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
              },
              "id": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
              },
              "version": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
              }
            }
          }
        },
        "source": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/source"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:artifact-contract:v2#/$defs/artifact"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "artifacts"
      ],
      "properties": {
        "schemaVersion": {
          "const": "truthsrc.artifact-binding/v2"
        },
        "artifacts": {
          "$ref": "urn:truthsrc:artifact-contract:v2#/$defs/artifacts"
        }
      }
    }
  }
}
