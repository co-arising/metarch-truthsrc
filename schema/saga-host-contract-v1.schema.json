{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truthsrc:saga-host-contract:v1",
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "version"
      ],
      "properties": {
        "ref": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
        },
        "version": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        }
      }
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "transaction-id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "slot"
          ],
          "properties": {
            "kind": {
              "const": "args"
            },
            "slot": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "stepId",
            "phase",
            "slot"
          ],
          "properties": {
            "kind": {
              "const": "receipt-field"
            },
            "stepId": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            },
            "phase": {
              "enum": [
                "prepare",
                "commit",
                "compensate"
              ]
            },
            "slot": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            }
          }
        }
      ]
    },
    "start": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref",
            "stepId"
          ],
          "properties": {
            "kind": {
              "const": "direct"
            },
            "ref": {
              "type": "null"
            },
            "stepId": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref",
            "stepId"
          ],
          "properties": {
            "kind": {
              "const": "pipeline"
            },
            "ref": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
            },
            "stepId": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triggerId",
        "kind",
        "source",
        "inputType",
        "port",
        "startOwner"
      ],
      "properties": {
        "triggerId": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "kind": {
          "enum": [
            "command",
            "event"
          ]
        },
        "source": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
        },
        "inputType": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/valueType"
        },
        "port": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/port"
        },
        "startOwner": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/start"
        }
      }
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "port",
        "inputKeys",
        "originalInputs",
        "encoding",
        "before",
        "conflict"
      ],
      "properties": {
        "id": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "version": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "port": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/port"
        },
        "inputKeys": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
          },
          "minItems": 1
        },
        "originalInputs": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
          },
          "minItems": 1
        },
        "encoding": {
          "const": "length-prefixed-utf8"
        },
        "before": {
          "const": "phase-effects"
        },
        "conflict": {
          "const": "reject-different-input"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "receiptType",
        "identity",
        "payload",
        "codec",
        "payloadCompatibility"
      ],
      "properties": {
        "kind": {
          "const": "typed-record"
        },
        "receiptType": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/valueType"
        },
        "identity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "member"
            ],
            "properties": {
              "key": {
                "enum": [
                  "txid",
                  "definition-version",
                  "args-digest",
                  "participant",
                  "resource",
                  "step",
                  "phase"
                ]
              },
              "member": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
              }
            }
          },
          "minItems": 7
        },
        "payload": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "output",
              "member"
            ],
            "properties": {
              "output": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
              },
              "member": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
              }
            }
          },
          "minItems": 0
        },
        "codec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "runtime"
          ],
          "properties": {
            "contract": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
                },
                "version": {
                  "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
                }
              }
            },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            }
          }
        },
        "payloadCompatibility": {
          "const": "exact"
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "inputType",
        "mode",
        "identity"
      ],
      "properties": {
        "port": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/port"
        },
        "inputType": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/valueType"
        },
        "mode": {
          "const": "read-only"
        },
        "identity": {
          "const": [
            "txid",
            "definition-version",
            "args-digest",
            "participant",
            "resource",
            "step",
            "phase"
          ]
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "outputs"
      ],
      "properties": {
        "event": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "output"
            ],
            "properties": {
              "slot": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
              },
              "output": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
              }
            }
          },
          "minItems": 0
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "command",
        "parameters",
        "inputType",
        "executePort",
        "confirmation",
        "query",
        "evidence"
      ],
      "properties": {
        "phase": {
          "enum": [
            "prepare",
            "commit",
            "compensate"
          ]
        },
        "command": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter",
              "input"
            ],
            "properties": {
              "parameter": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
              },
              "input": {
                "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/input"
              }
            }
          },
          "minItems": 0
        },
        "inputType": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/valueType"
        },
        "executePort": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/port"
        },
        "confirmation": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/confirmation"
        },
        "query": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/query"
        },
        "evidence": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/evidence"
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "participantId",
        "aggregate",
        "resourceInput",
        "phases"
      ],
      "properties": {
        "stepId": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "participantId": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "aggregate": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
        },
        "resourceInput": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/phase"
          },
          "minItems": 3
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "event",
        "inputType",
        "destination",
        "authorityPort",
        "deliveryPort",
        "associationVersion",
        "inputs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "succeeded",
            "rejected-before-effects",
            "compensated",
            "recovery-required",
            "outcome-unknown"
          ]
        },
        "event": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
        },
        "inputType": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/valueType"
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aggregate",
            "resourceInput"
          ],
          "properties": {
            "aggregate": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
            },
            "resourceInput": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
            }
          }
        },
        "authorityPort": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/port"
        },
        "deliveryPort": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/port"
        },
        "associationVersion": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "input"
            ],
            "properties": {
              "slot": {
                "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
              },
              "input": {
                "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/input"
              }
            }
          }
        }
      }
    },
    "technicalPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "port",
        "implementation"
      ],
      "properties": {
        "role": {
          "enum": [
            "entry",
            "association",
            "phase-execute",
            "phase-query",
            "authority",
            "result-delivery",
            "resource-policy",
            "external-submission",
            "external-query",
            "external-event",
            "occurrence-source",
            "readside"
          ]
        },
        "port": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/port"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            },
            "version": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            }
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "saga",
        "entry",
        "association",
        "participants",
        "results",
        "technicalPorts",
        "source",
        "argsType"
      ],
      "properties": {
        "id": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "version": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
        },
        "saga": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "version"
          ],
          "properties": {
            "ref": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/reference"
            },
            "version": {
              "$ref": "urn:truthsrc:product-compilation:v1#/$defs/text"
            }
          }
        },
        "entry": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/entry"
        },
        "association": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/association"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/participant"
          },
          "minItems": 1
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/result"
          },
          "minItems": 5
        },
        "technicalPorts": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/technicalPort"
          },
          "minItems": 1
        },
        "source": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/source"
        },
        "argsType": {
          "$ref": "urn:truthsrc:product-compilation:v1#/$defs/valueType"
        }
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts"
      ],
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/host"
          },
          "minItems": 0
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "hosts"
      ],
      "properties": {
        "schemaVersion": {
          "const": "truthsrc.saga-host-binding/v1"
        },
        "hosts": {
          "$ref": "urn:truthsrc:saga-host-contract:v1#/$defs/hosts"
        }
      }
    }
  }
}
