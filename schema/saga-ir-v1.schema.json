{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madpolaris.dev/contracts/saga-ir-v1.schema.json",
  "title": "Saga v1 contract-only IR, business declarations and technical bindings",
  "description": "Only aggregate-owned commands (the public slice projection) and events resolve. Sessions are narrative, not proof of ownership. No runtime certification, code evaluation, implicit joins, dynamic participant expansion, numeric money or literal dataflow in v1. All-none steps are explicitly read-only. Step output refs are phase-qualified durable receipts; compensation may read only its own Prepare outputs. Digest is SHA-256 of stable JSON {schemaVersion,workshop,readiness,sagas}, excluding provenance/anchors.",
  "type": "object",
  "required": ["schemaVersion", "workshop", "readiness", "sagas", "digest", "sourceMap"],
  "properties": {
    "schemaVersion": {"const": "truthsrc.saga-ir/v1"},
    "workshop": {"$ref": "#/$defs/text"},
    "readiness": {"const": "contract-only"},
    "sagas": {"type": "array", "items": {"$ref": "#/$defs/compiledSaga"}},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"},
    "sourceMap": {"type": "object", "propertyNames": {"$ref": "#/$defs/pointer"}, "additionalProperties": {"$ref": "#/$defs/source"}}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?![\\s\\S])"},
    "symbol": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "pointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*(?![\\s\\S])"},
    "slot": {"type": "object", "required": ["slot", "type"], "properties": {"slot": {"$ref": "#/$defs/id"}, "type": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
    "slots": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/slot"}},
    "ref": {"type": "string", "pattern": "^(?:txid|args:[A-Za-z][A-Za-z0-9_-]*|step:[A-Za-z][A-Za-z0-9_-]*:(?:prepare|commit|compensate):[A-Za-z][A-Za-z0-9_-]*)(?![\\s\\S])"},
    "typedRef": {"type": "object", "required": ["ref", "type"], "properties": {"ref": {"$ref": "#/$defs/ref"}, "type": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
    "argRef": {"type": "object", "required": ["ref", "type"], "properties": {"ref": {"type": "string", "pattern": "^args:[A-Za-z][A-Za-z0-9_-]*(?![\\s\\S])"}, "type": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
    "mapping": {"type": "object", "required": ["slot", "ref", "type"], "properties": {"slot": {"$ref": "#/$defs/id"}, "ref": {"$ref": "#/$defs/ref"}, "type": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
    "mappings": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/mapping"}},
    "ownedRef": {"type": "object", "required": ["aggregate", "name"], "properties": {"aggregate": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}}, "additionalProperties": false},
    "none": {"type": "object", "required": ["kind", "reason"], "properties": {"kind": {"const": "none"}, "reason": {"const": "read-only"}}, "additionalProperties": false},
    "phase": {"description": "v1 resource-typed command bindings must use the step participant's exact resource arg. No guessing address from first field, and no unsupported cross-resource parameter semantics.", "oneOf": [
      {"$ref": "#/$defs/none"},
      {"type": "object", "required": ["kind", "commandRef", "bindings", "outputs"], "properties": {"kind": {"const": "command"}, "commandRef": {"$ref": "#/$defs/ownedRef"}, "bindings": {"$ref": "#/$defs/mappings"}, "outputs": {"$ref": "#/$defs/slots"}}, "additionalProperties": false}
    ]},
    "phases": {"type": "object", "required": ["prepare", "commit", "compensate"], "properties": {"prepare": {"$ref": "#/$defs/phase"}, "commit": {"$ref": "#/$defs/phase"}, "compensate": {"$ref": "#/$defs/phase"}}, "additionalProperties": false},
    "participant": {"type": "object", "required": ["id", "aggregate", "resourceRef"], "properties": {"id": {"$ref": "#/$defs/id"}, "aggregate": {"$ref": "#/$defs/text"}, "resourceRef": {"$ref": "#/$defs/argRef"}}, "additionalProperties": false},
    "step": {"type": "object", "required": ["id", "participant", "group", "phases"], "properties": {"id": {"$ref": "#/$defs/id"}, "participant": {"$ref": "#/$defs/id"}, "group": {"$ref": "#/$defs/limit"}, "phases": {"$ref": "#/$defs/phases"}}, "additionalProperties": false},
    "group": {"description": "v1 groups are explicit serial numeric barriers: each group depends transitively on the previous numeric group. Steps within one group are concurrent and cannot reuse a participant. No implicit array-order join or dynamic DAG scheduler.", "type": "object", "required": ["id", "dependsOn"], "properties": {"id": {"$ref": "#/$defs/limit"}, "dependsOn": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/limit"}}}, "additionalProperties": false},
    "resultKind": {"enum": ["succeeded", "rejected-before-effects", "compensated", "recovery-required", "outcome-unknown"]},
    "resultKinds": {"const": ["succeeded", "rejected-before-effects", "compensated", "recovery-required", "outcome-unknown"]},
    "triggerMapping": {"type": "object", "required": ["slot", "ref", "type"], "properties": {"slot": {"$ref": "#/$defs/id"}, "ref": {"type": "string", "pattern": "^source:[A-Za-z][A-Za-z0-9_-]*(?![\\s\\S])"}, "type": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
    "trigger": {"description": "Each trigger is an independent start mapping, not an inferred OR/AND/join. sourceRef resolves the owned command/event; source:<field> refs map every declared arg exactly. The named idempotency mapper derives stable transaction identity under Saga ID/version from durable business operation ID and rejects different args; no clock/random/generation/attempt identity.", "type": "object", "required": ["id", "kind", "sourceRef", "argsMapping", "idempotency"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["event", "command"]}, "sourceRef": {"$ref": "#/$defs/ownedRef"},
      "argsMapping": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/triggerMapping"}},
      "idempotency": {"type": "object", "required": ["ref", "type", "scope", "conflict"], "properties": {"ref": {"type": "string", "pattern": "^source:[A-Za-z][A-Za-z0-9_-]*(?![\\s\\S])"}, "type": {"$ref": "#/$defs/id"}, "scope": {"const": "saga-version"}, "conflict": {"const": "reject-different-args"}}, "additionalProperties": false}
    }, "additionalProperties": false},
    "completion": {"type": "object", "required": ["kind", "eventRef", "bindings"], "properties": {"kind": {"$ref": "#/$defs/resultKind"}, "eventRef": {"$ref": "#/$defs/ownedRef"}, "bindings": {"$ref": "#/$defs/mappings"}}, "additionalProperties": false},
    "resilience": {"description": "Bounded retry budgets retain the original operation identity. Retries require idempotency or reconciled nonexecution. totalTimeoutMs covers maxAttempts*(phaseTimeoutMs+queryTimeoutMs)+(maxAttempts-1)*backoffMs; expiry yields controlled recovery/unknown, not business rejection or automatic compensation.", "type": "object", "required": ["maxAttempts", "phaseTimeoutMs", "queryTimeoutMs", "backoffMs", "totalTimeoutMs"], "properties": {"maxAttempts": {"$ref": "#/$defs/limit"}, "phaseTimeoutMs": {"$ref": "#/$defs/limit"}, "queryTimeoutMs": {"$ref": "#/$defs/limit"}, "backoffMs": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "totalTimeoutMs": {"$ref": "#/$defs/limit"}}, "additionalProperties": false},
    "safety": {"description": "All Prepare receipts must be confirmed before durably recording CommitDecision; only then Commit. AbortDecision is valid only before CommitDecision; reconcile unknown Prepare before compensating confirmed reservations. After CommitDecision never auto-compensate. Success requires every Commit confirmation. These are required host semantics, not observed runtime facts.", "type": "object", "required": ["commitDecision", "abortDecision", "afterCommit", "unknown", "compensation", "cancelBeforePrepare", "retryIdentity", "manualRecovery"], "properties": {
      "commitDecision": {"const": "durable-before-commit"}, "abortDecision": {"const": "durable-before-compensate"}, "afterCommit": {"const": "forward-recovery"}, "unknown": {"const": "reconcile-before-resume"}, "compensation": {"const": "confirmed-reservations"}, "cancelBeforePrepare": {"const": "empty-release-and-fence"}, "retryIdentity": {"const": "stable-operation"}, "manualRecovery": {"const": "authorized-reconciliation-evidence"}
    }, "additionalProperties": false},
    "manifest": {"oneOf": [
      {"type": "object", "required": ["mode", "durable"], "properties": {"mode": {"const": "static"}, "durable": {"const": true}}, "additionalProperties": false},
      {"type": "object", "required": ["mode", "durable", "ref", "version", "selection"], "properties": {"mode": {"const": "durable-reference"}, "durable": {"const": true}, "ref": {"$ref": "#/$defs/argRef"}, "version": {"$ref": "#/$defs/id"}, "selection": {"const": "frozen-before-prepare"}}, "additionalProperties": false}
    ]},
    "admission": {"description": "Static logical participant count and each concurrent barrier must fit the declared bounds. maxItemsPerChunk bounds each collection arg including nested collection cardinality; such args require durable-reference manifest. Runtime value conservation, arg inequality and manifest contents require host validation and are never certified here.", "type": "object", "required": ["maxParticipants", "maxInFlight", "maxItemsPerChunk", "manifest"], "properties": {"maxParticipants": {"$ref": "#/$defs/limit"}, "maxInFlight": {"$ref": "#/$defs/limit"}, "maxItemsPerChunk": {"$ref": "#/$defs/limit"}, "manifest": {"$ref": "#/$defs/manifest"}}, "additionalProperties": false},
    "payload": {"type": "object", "required": ["schemaVersion", "purpose", "invariants", "transactionIdType", "args", "participants", "groups", "steps", "resilience", "safety", "admission", "triggers", "resultKinds", "completions"], "properties": {
      "schemaVersion": {"const": "truthsrc.saga/v1"}, "purpose": {"$ref": "#/$defs/text"}, "invariants": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/text"}}, "transactionIdType": {"$ref": "#/$defs/id"},
      "args": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/slot"}},
      "participants": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/participant"}},
      "groups": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/group"}},
      "steps": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/step"}},
      "resilience": {"$ref": "#/$defs/resilience"}, "safety": {"$ref": "#/$defs/safety"}, "admission": {"$ref": "#/$defs/admission"},
      "triggers": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/trigger"}}, "resultKinds": {"$ref": "#/$defs/resultKinds"},
      "completions": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/completion"}}
    }, "additionalProperties": false},
    "saga": {"type": "object", "required": ["id", "name", "seq", "version", "payload"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}, "seq": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "version": {"$ref": "#/$defs/id"}, "payload": {"$ref": "#/$defs/payload"}}, "additionalProperties": false},
    "canonical": {"type": "object", "required": ["schemaVersion", "workshop"], "properties": {"schemaVersion": {"const": "truthsrc/v1"}, "workshop": {"$ref": "#/$defs/text"}, "aggregates": {"type": "array"}, "sessions": {"type": "array"}, "sagas": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/saga"}}}, "additionalProperties": true},
    "typeBinding": {"oneOf": [
      {"type": "object", "required": ["id", "canonicalType", "implementation", "kind", "minLength", "maxLength"], "properties": {"id": {"$ref": "#/$defs/id"}, "canonicalType": {"$ref": "#/$defs/text"}, "implementation": {"$ref": "#/$defs/symbol"}, "kind": {"enum": ["id", "string"]}, "minLength": {"$ref": "#/$defs/limit"}, "maxLength": {"$ref": "#/$defs/limit"}}, "additionalProperties": false},
      {"type": "object", "required": ["id", "canonicalType", "implementation", "kind"], "properties": {"id": {"$ref": "#/$defs/id"}, "canonicalType": {"$ref": "#/$defs/text"}, "implementation": {"$ref": "#/$defs/symbol"}, "kind": {"const": "boolean"}}, "additionalProperties": false},
      {"type": "object", "required": ["id", "canonicalType", "implementation", "kind", "minimum", "maximum"], "properties": {"id": {"$ref": "#/$defs/id"}, "canonicalType": {"$ref": "#/$defs/text"}, "implementation": {"$ref": "#/$defs/symbol"}, "kind": {"const": "integer"}, "minimum": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}, "maximum": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}}, "additionalProperties": false},
      {"type": "object", "required": ["id", "canonicalType", "implementation", "kind", "values"], "properties": {"id": {"$ref": "#/$defs/id"}, "canonicalType": {"$ref": "#/$defs/text"}, "implementation": {"$ref": "#/$defs/symbol"}, "kind": {"const": "enum"}, "values": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}, "additionalProperties": false},
      {"type": "object", "required": ["id", "canonicalType", "implementation", "kind", "elementType", "minItems", "maxItems"], "properties": {"id": {"$ref": "#/$defs/id"}, "canonicalType": {"$ref": "#/$defs/text"}, "implementation": {"$ref": "#/$defs/symbol"}, "kind": {"const": "collection"}, "elementType": {"$ref": "#/$defs/id"}, "minItems": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "maxItems": {"$ref": "#/$defs/limit"}}, "additionalProperties": false},
      {"type": "object", "required": ["id", "canonicalType", "implementation", "kind", "fields"], "properties": {"id": {"$ref": "#/$defs/id"}, "canonicalType": {"$ref": "#/$defs/text"}, "implementation": {"$ref": "#/$defs/symbol"}, "kind": {"const": "value-object"}, "fields": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/slot"}}}, "additionalProperties": false},
      {"type": "object", "required": ["id", "canonicalType", "implementation", "kind", "currency", "amountEncoding", "scale", "precision", "codec"], "properties": {"id": {"$ref": "#/$defs/id"}, "canonicalType": {"$ref": "#/$defs/text"}, "implementation": {"$ref": "#/$defs/symbol"}, "kind": {"const": "money"}, "currency": {"const": "ISO-4217"}, "amountEncoding": {"enum": ["minor-unit-string", "decimal-string"]}, "scale": {"type": "integer", "minimum": 0, "maximum": 18}, "precision": {"type": "integer", "minimum": 1, "maximum": 38}, "codec": {"$ref": "#/$defs/symbol"}}, "additionalProperties": false},
      {"type": "object", "required": ["id", "canonicalType", "implementation", "kind", "readable", "version"], "properties": {"id": {"$ref": "#/$defs/id"}, "canonicalType": {"$ref": "#/$defs/text"}, "implementation": {"$ref": "#/$defs/symbol"}, "kind": {"const": "manifest-reference"}, "readable": {"const": true}, "version": {"$ref": "#/$defs/id"}}, "additionalProperties": false}
    ]},
    "operationIdentity": {"const": ["txid", "definition-version", "participant", "resource", "step", "phase"]},
    "receiptIdentity": {"const": ["txid", "definition-version", "args-digest", "participant", "resource", "step", "phase"]},
    "receiptMapping": {"type": "object", "required": ["slot", "ref", "type"], "properties": {"slot": {"$ref": "#/$defs/id"}, "ref": {"type": "string", "pattern": "^receipt:[A-Za-z][A-Za-z0-9_-]*(?![\\s\\S])"}, "type": {"$ref": "#/$defs/id"}}, "additionalProperties": false},
    "phaseBinding": {"oneOf": [
      {"$ref": "#/$defs/none"},
      {"type": "object", "required": ["kind", "port", "commandMapper", "confirmation", "query", "receipt", "idempotency"], "properties": {
        "kind": {"const": "command"}, "port": {"$ref": "#/$defs/symbol"}, "commandMapper": {"$ref": "#/$defs/symbol"},
        "confirmation": {"type": "object", "required": ["kind", "eventRef", "mapper", "outputs"], "properties": {"kind": {"const": "durable-receipt"}, "eventRef": {"$ref": "#/$defs/ownedRef"}, "mapper": {"$ref": "#/$defs/symbol"}, "outputs": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/receiptMapping"}}}, "additionalProperties": false},
        "query": {"type": "object", "required": ["mapper", "mode", "identity", "resultKinds"], "properties": {"mapper": {"$ref": "#/$defs/symbol"}, "mode": {"const": "read-only"}, "identity": {"$ref": "#/$defs/receiptIdentity"}, "resultKinds": {"const": ["confirmed", "not-executed", "unknown"]}}, "additionalProperties": false},
        "receipt": {"type": "object", "required": ["mapper", "version", "durable", "identity", "payloadCompatibility", "evidence"], "properties": {"mapper": {"$ref": "#/$defs/symbol"}, "version": {"$ref": "#/$defs/id"}, "durable": {"const": true}, "identity": {"$ref": "#/$defs/receiptIdentity"}, "payloadCompatibility": {"const": "exact"}, "evidence": {"const": "reservation-decision-effect-reconciliation"}}, "additionalProperties": false},
        "idempotency": {"type": "object", "required": ["mapper", "identity", "payloadConflict", "attemptIdentity"], "properties": {"mapper": {"$ref": "#/$defs/symbol"}, "identity": {"$ref": "#/$defs/operationIdentity"}, "payloadConflict": {"const": "reject"}, "attemptIdentity": {"const": "excluded"}}, "additionalProperties": false}
      }, "additionalProperties": false}
    ]},
    "stepBinding": {"type": "object", "required": ["stepId", "phases"], "properties": {"stepId": {"$ref": "#/$defs/id"}, "phases": {"type": "object", "required": ["prepare", "commit", "compensate"], "properties": {"prepare": {"$ref": "#/$defs/phaseBinding"}, "commit": {"$ref": "#/$defs/phaseBinding"}, "compensate": {"$ref": "#/$defs/phaseBinding"}}, "additionalProperties": false}}, "additionalProperties": false},
    "participantBinding": {"type": "object", "required": ["participantId", "addressing"], "properties": {"participantId": {"$ref": "#/$defs/id"}, "addressing": {"type": "object", "required": ["resolver", "aggregate", "resourceType", "mode"], "properties": {"resolver": {"$ref": "#/$defs/symbol"}, "aggregate": {"$ref": "#/$defs/text"}, "resourceType": {"$ref": "#/$defs/id"}, "mode": {"const": "exact-resource"}}, "additionalProperties": false}}, "additionalProperties": false},
    "capabilities": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"enum": ["durable-commit-decision", "durable-abort-decision", "typed-nonterminal-unknown", "safe-status-reattach", "receipt-reconciliation", "participant-idempotency-query", "pinned-definition-codec", "manual-evidence-authorization", "cancel-before-prepare-fencing", "durable-manifest"]}},
    "sagaBinding": {"type": "object", "required": ["sagaId", "version", "module", "engine", "codec", "types", "participants", "steps", "triggerMappers", "completionMappers"], "properties": {
      "sagaId": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"}, "module": {"$ref": "#/$defs/symbol"},
      "engine": {"type": "object", "required": ["artifact", "apiMode", "entrypoint", "capabilities"], "properties": {"artifact": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+(?![\\s\\S])"}, "apiMode": {"const": "strict"}, "entrypoint": {"$ref": "#/$defs/symbol"}, "capabilities": {"type": "object", "required": ["required"], "properties": {"required": {"$ref": "#/$defs/capabilities"}}, "additionalProperties": false}}, "additionalProperties": false},
      "codec": {"type": "object", "required": ["id", "version", "compatibleVersions", "mapper"], "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"}, "compatibleVersions": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "mapper": {"$ref": "#/$defs/symbol"}}, "additionalProperties": false},
      "types": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/typeBinding"}},
      "participants": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/participantBinding"}},
      "steps": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/stepBinding"}},
      "triggerMappers": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "object", "required": ["triggerId", "argsMapper", "idempotencyMapper"], "properties": {"triggerId": {"$ref": "#/$defs/id"}, "argsMapper": {"$ref": "#/$defs/symbol"}, "idempotencyMapper": {"$ref": "#/$defs/symbol"}}, "additionalProperties": false}},
      "completionMappers": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["kind", "mapper"], "properties": {"kind": {"$ref": "#/$defs/resultKind"}, "mapper": {"$ref": "#/$defs/symbol"}}, "additionalProperties": false}}
    }, "additionalProperties": false},
    "location": {"type": "object", "required": ["line", "column"], "properties": {"line": {"$ref": "#/$defs/limit"}, "column": {"$ref": "#/$defs/limit"}}, "additionalProperties": false},
    "sourceHint": {"type": "object", "required": ["file"], "properties": {"file": {"$ref": "#/$defs/text"}, "atom": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/pointer"}, "location": {"$ref": "#/$defs/location"}}, "additionalProperties": false},
    "sourceHints": {"type": "object", "properties": {"canonical": {"type": "object", "propertyNames": {"$ref": "#/$defs/pointer"}, "additionalProperties": {"$ref": "#/$defs/sourceHint"}}, "binding": {"type": "object", "propertyNames": {"$ref": "#/$defs/pointer"}, "additionalProperties": {"$ref": "#/$defs/sourceHint"}}}, "additionalProperties": false},
    "bindingDocument": {"type": "object", "required": ["schemaVersion", "sagas"], "properties": {"schemaVersion": {"const": "truthsrc.saga-binding/v1"}, "sagas": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/sagaBinding"}}, "sourceMap": {"$ref": "#/$defs/sourceHints"}}, "additionalProperties": false},
    "source": {"type": "object", "required": ["document", "pointer", "file", "atom", "path", "location"], "properties": {"document": {"enum": ["canonical", "binding"]}, "pointer": {"$ref": "#/$defs/pointer"}, "file": {"type": ["string", "null"]}, "atom": {"type": ["string", "null"]}, "path": {"$ref": "#/$defs/pointer"}, "location": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/location"}]}}, "additionalProperties": false},
    "compiledSaga": {"type": "object", "required": ["definition", "binding", "readiness"], "properties": {"definition": {"$ref": "#/$defs/saga"}, "binding": {"$ref": "#/$defs/sagaBinding"}, "readiness": {"const": "contract-only"}}, "additionalProperties": false}
  }
}
