{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "generated-scaffold/ts/**/*.ts",
    "generated-tests/ts/**/*.ts",
    "handwritten/**/*.ts"
  ]
}
