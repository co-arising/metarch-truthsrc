{
  "schemaVersion": "truthsrc.projection-apply-event-input/v1",
  "basePackage": "example.stockreservation",
  "moduleName": "StockLedgerProjectionModule",
  "views": [
    {
      "viewLabel": "台账视图",
      "viewName": "StockLedgerView",
      "tableObject": "StockLedgerTable",
      "kernelClass": "StockLedgerApplyEvent",
      "semanticsFace": "StockLedgerApplyEventSemantics",
      "semanticsImpl": "StockLedgerApplyEventSemanticsImpl",
      "identityScheme": null,
      "hooks": [
        "emptyRow",
        "stamped",
        "text"
      ],
      "kernelHelpers": [
        "upsertBy"
      ],
      "events": [
        {
          "name": "Reserved",
          "fqn": "example.stockreservation.domain.entities.ReservationEntity.Reserved",
          "applyForm": "create",
          "columns": [
            {
              "name": "skuId",
              "value": "e.skuId"
            },
            {
              "name": "label",
              "value": "sem.text(e.label)"
            },
            {
              "name": "quantity",
              "value": "e.quantity"
            },
            {
              "name": "reserved",
              "value": "true"
            },
            {
              "name": "lastEventAt",
              "value": "sem.stamped(e.occurredAt)"
            },
            {
              "name": "type",
              "value": "\"reserved\""
            },
            {
              "name": "tenantId",
              "value": "e.tenantId"
            }
          ]
        },
        {
          "name": "QuantityAdjusted",
          "fqn": "example.stockreservation.domain.entities.ReservationEntity.QuantityAdjusted",
          "applyForm": "updateOnly",
          "columns": [
            {
              "name": "quantity",
              "value": "row.quantity + e.delta"
            },
            {
              "name": "lastEventAt",
              "value": "sem.stamped(e.occurredAt)"
            }
          ]
        },
        {
          "name": "TagUpserted",
          "fqn": "example.stockreservation.domain.entities.ReservationEntity.TagUpserted",
          "applyForm": "updateOnly",
          "columns": [
            {
              "name": "tags",
              "value": "upsertBy(row.tags, e.tag)(t => t)"
            }
          ]
        },
        {
          "name": "LedgerSettled",
          "fqn": "example.stockreservation.domain.entities.ReservationEntity.LedgerSettled",
          "applyForm": "updateOnly",
          "columns": [
            {
              "name": "reserved",
              "value": "false"
            },
            {
              "name": "settledAt",
              "value": "Some(e.occurredAt)"
            },
            {
              "name": "lastEventAt",
              "value": "sem.stamped(e.occurredAt)"
            }
          ]
        },
        {
          "name": "LedgerReopened",
          "fqn": "example.stockreservation.domain.entities.ReservationEntity.LedgerReopened",
          "applyForm": "updateOnly",
          "docNote": "None patch＝清列判例",
          "columns": [
            {
              "name": "reserved",
              "value": "true"
            },
            {
              "name": "settledAt",
              "value": "None"
            },
            {
              "name": "lastEventAt",
              "value": "sem.stamped(e.occurredAt)"
            }
          ]
        },
        {
          "name": "ReservationCancelled",
          "fqn": "example.stockreservation.domain.entities.ReservationEntity.ReservationCancelled",
          "applyForm": "delete",
          "deletePairs": [
            {
              "name": "sourceType",
              "expr": "\"ledger-root\""
            },
            {
              "name": "sourceId",
              "expr": "e.cancelledId.toString"
            }
          ]
        }
      ]
    },
    {
      "viewLabel": "快照视图",
      "viewName": "StockLedgerSnapshotView",
      "tableObject": "StockLedgerSnapshotTable",
      "kernelClass": "StockLedgerSnapshotApplyEvent",
      "semanticsFace": "StockLedgerSnapshotApplyEventSemantics",
      "semanticsImpl": "StockLedgerSnapshotApplyEventSemanticsImpl",
      "identityScheme": "persistenceId",
      "hooks": [
        "emptyRow",
        "stamped"
      ],
      "kernelHelpers": [],
      "events": [
        {
          "name": "SnapshotRecorded",
          "fqn": "example.stockreservation.domain.entities.ReservationEntity.SnapshotRecorded",
          "applyForm": "persistenceIdCreate",
          "tenantEventField": "e.tenantId",
          "columns": [
            {
              "name": "totalAmount",
              "value": "e.totalAmount"
            },
            {
              "name": "occurredAt",
              "value": "sem.stamped(e.occurredAt)"
            }
          ]
        },
        {
          "name": "SnapshotAmended",
          "fqn": "example.stockreservation.domain.entities.ReservationEntity.SnapshotAmended",
          "applyForm": "updateOnly",
          "columns": [
            {
              "name": "totalAmount",
              "value": "row.totalAmount + e.delta"
            }
          ]
        }
      ]
    }
  ],
