              }
            ]
          },
          {
            "id": "VerifyAllocation",
            "implementation": "inventory.VerifyAllocation",
            "effect": "pure",
            "confirmation": "checkpoint",
            "idempotency": {
              "mode": "none"
            },
            "inputs": [
              {
                "slot": "allocation",
                "type": "AllocationId"
              }
            ],
            "outputs": [
              {
                "slot": "allocation",
                "type": "AllocationId"
              }
            ],
            "outcomes": [
              {
                "code": "Confirmed",
                "kind": "success"
              },
              {
                "code": "Unavailable",
                "kind": "infrastructure-failure"
              }
            ]
          }
        ]
      }
    }
  ]
