{
  "schemaVersion": "truthsrc.child-plan-binding/v1",
  "plans": [
    {
      "ref": {
        "context": "inventory",
        "kind": "pipeline",
        "owner": [],
        "id": "allocation-child"
      },
      "version": "child-v1",
      "binding": {
        "pipelineId": "allocation-child",
        "engine": "monarch-persistence/0.2.1",
        "module": "inventory.ChildInspection",
        "codec": {
          "id": "ChildInspectionState",
          "version": "child-v1",
          "compatibleVersions": [
